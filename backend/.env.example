# Plantilla de variables de entorno del backend.
# Copiá este archivo como ".env" y completá los valores de tu proyecto Supabase
# (Project Settings → API).

# Puerto del servidor Express.
PORT=3000

# URL del proyecto de Supabase, ej. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Clave pública (anon). La usa el login/registro, que corre con los permisos
# del usuario final y respeta RLS.
SUPABASE_ANON_KEY=

# Clave privada (service_role). BYPASSEA RLS: la usan los servicios que ya
# validaron al usuario con el authMiddleware, y siempre acotan por el user_id
# que sale del JWT verificado (nunca del body de la request).
# ⚠️ NUNCA exponerla al cliente ni commitearla.
SUPABASE_SERVICE_ROLE_KEY=
