{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/lesson/:id", "destination": "/lesson/[id].html" },
    { "source": "/alphabet/:letter", "destination": "/alphabet/[letter].html" }
  ]
}
